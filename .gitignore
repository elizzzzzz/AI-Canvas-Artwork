# Local secrets and environment files
.env
.env.*
!.env.example

# AICanvas runtime state and temporary task records
AICANVAS-*.json

# Generated media and local previews
outputs/
generated/
previews/
renders/

# Local editor and OS files
.DS_Store
.vscode/
.idea/

# Python and Node caches
__pycache__/
*.py[cod]
node_modules/

# Versioned 3D asset evidence (not disposable media previews)
!production/asset-library/previews/
!production/asset-library/previews/*.png

# Full-film generation queue outputs (uploaded separately after completion)
production/full-generation-v2/media/
production/full-generation-v2/work/
